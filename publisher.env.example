# Bottle Net - Video Publisher: OAuth client credentials (template).
#
# Copy this file to ".env" in the Bottle Net data folder (Settings shows the
# folder; on Windows it is %LOCALAPPDATA%\bottle-net) or set these as
# environment variables. NEVER commit the real file.
#
# These identify YOUR developer apps at Google and Meta. They are not your
# Google/Facebook passwords - Bottle Net never asks for those.

# Google Cloud Console -> YouTube Data API v3 -> OAuth client ("Desktop app")
BOTTLE_NET_YOUTUBE_CLIENT_ID=
BOTTLE_NET_YOUTUBE_CLIENT_SECRET=
# ...or the path to the client JSON file downloaded from Google:
# BOTTLE_NET_YOUTUBE_CLIENT_SECRETS_FILE=C:\path\to\client_secret.json

# Meta for Developers -> your app -> Settings -> Basic
BOTTLE_NET_FACEBOOK_APP_ID=
BOTTLE_NET_FACEBOOK_APP_SECRET=
# Optional: pin a Graph API version (default: the app's version)
# BOTTLE_NET_FACEBOOK_GRAPH_VERSION=v23.0
